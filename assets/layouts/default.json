    {"id": "shoot", "type": "slider", "binding": "shoot", "label": "摩擦轮", "min": 0, "max": 6000, "step": 100, "initial": 0, "vertical": true, "returnToZero": true, "x": 0.84, "y": 0.20, "w": 0.15, "h": 0.78}
